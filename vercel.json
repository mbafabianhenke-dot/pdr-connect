{
  "framework": "nextjs",
  "regions": ["fra1"],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://pdrconnect.eu"
  },
  "headers": [
    {
      "source": "/api/stripe/webhook",
      "headers": [{ "key": "cache-control", "value": "no-store" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/profile-reminder",
      "schedule": "0 9 * * *"
    }
  ]
}
